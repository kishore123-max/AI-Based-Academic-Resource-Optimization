# Optional. Every value below is the built-in default, so the API runs without a .env file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default database is SQLite (campusflow.db in the project root). To use another one:
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=campusflow
# DATABASE_URL=postgresql://user:password@localhost:5432/campusflow
